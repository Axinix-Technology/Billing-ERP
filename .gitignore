# ==============================================================================
# Billing-ERP Root .gitignore
# Covers Frontend (React / Vite / Node) and Backend (Django / Python)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
backend/.venv/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local

# ------------------------------------------------------------------------------
# Python & Django
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# SQLite & Database dumps
*.sqlite3
*.sqlite3-journal
*.db

# Django media & static collection
backend/media/
backend/static/
media/
staticfiles/

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ------------------------------------------------------------------------------
# Frontend & Build Artifacts (React / Vite)
# ------------------------------------------------------------------------------
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local
.npm
.eslintcache
.stylelintcache
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# Logs & Process Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
