DJANGO_SETTINGS_MODULE="config.settings"
SECRET_KEY="django-insecure-billing-erp-axinix-core-dev-key"
DEBUG=True
ALLOWED_HOSTS=*
PORT=8000

# Database Engine Toggle (True = local SQLite, False = MySQL)
USE_SQLITE=True
DB_NAME=billing_erp_dev.sqlite3

# MySQL Credentials (used when USE_SQLITE=False)
MYSQL_DATABASE=teashop_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

